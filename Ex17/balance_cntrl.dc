# Exercise 17: balance-control synthesis
# Library/search paths come from the tutorial's .synopsys_dc.setup.
# SAED32 library names match the selected target .db filename.
set saed_lib [file rootname [file tail [lindex $target_library 0]]]

set fast_sim 0

file mkdir WORK
define_design_lib WORK -path ./WORK
analyze -format sverilog {PID.sv SegwayMath.sv balance_cntrl.sv}
elaborate balance_cntrl -parameters "fast_sim=$fast_sim"

if {[get_object_name [current_design]] ne "balance_cntrl"} {
    rename_design [get_object_name [current_design]] balance_cntrl
}
current_design balance_cntrl
link
check_design

# 125 MHz = 8 ns
create_clock -name clk -period 8.0 [get_ports clk]
set_dont_touch_network [get_ports clk]

# Input delay includes reset
set_input_delay -clock clk 0.3 \
    [remove_from_collection [all_inputs] [get_ports clk]]
set_driving_cell -library $saed_lib -lib_cell NAND2X2_RVT \
    [remove_from_collection [all_inputs] [get_ports {clk rst_n}]]

set_output_delay -clock clk 0.75 [all_outputs]
set_load 0.05 [all_outputs] ;# 50 fF = 0.05 pF in the SAED32 library.
set_max_transition 0.15 [current_design]

# use the 16000-square-micron wire-load model for the whole block
set auto_wire_load_selection false
set_wire_load_mode top
set_wire_load_model -name 16000 -library $saed_lib

# map the hierarchy first, then flatten and optimize again
compile -map_effort medium
ungroup -all -flatten
compile -map_effort medium

# report the final flattened, mapped design
report_timing -delay_type min -max_paths 10 > timing_min.rpt
report_timing -delay_type max -max_paths 10 > timing_max.rpt
report_area > area.rpt

# give generated names valid Verilog identifiers before writing the netlist
change_names -rules verilog -hierarchy
write -format verilog -hierarchy -output balance_cntrl.vg
